---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import ZhPostList from '~/components/ZhPostList.astro';
import { cleanSlug } from '~/utils/permalinks';
import { getZhPosts, zhPostsPerPage } from '~/utils/zh-blog';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getZhPosts();
  return [
    ...new Map(
      posts
        .map((post) => post.data.category)
        .filter((value): value is string => !!value)
        .map((category) => [cleanSlug(category), category])
    ).entries(),
  ].flatMap(([slug, category]) =>
    paginate(
      posts.filter((post) => cleanSlug(post.data.category ?? '') === slug),
      {
        params: { slug },
        pageSize: zhPostsPerPage,
        props: { category },
      }
    )
  );
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { category, page } = Astro.props as Props;
---

<ZhPostList
  title={`分类：${category}`}
  description="这个分类中的全部中文文章。"
  posts={page.data}
  currentPage={page.currentPage}
  prevUrl={page.url.prev}
  nextUrl={page.url.next}
/>
