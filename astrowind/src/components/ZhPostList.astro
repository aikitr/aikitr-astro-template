---
import Layout from '~/layouts/PageLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { cleanSlug, getPermalink } from '~/utils/permalinks';

interface Props {
  title: string;
  description: string;
  posts: CollectionEntry<'postZh'>[];
  currentPage?: number;
  prevUrl?: string;
  nextUrl?: string;
}
const { title, description, posts, currentPage = 1, prevUrl, nextUrl } = Astro.props;
---

<Layout
  metadata={{
    title: currentPage > 1 ? `${title} · 第 ${currentPage} 页` : title,
    description,
    robots: { index: currentPage === 1 },
  }}
>
  <section class="mx-auto max-w-4xl px-6 py-16">
    <h1 class="text-4xl font-bold">{title}</h1>
    <p class="mt-4 text-lg text-muted">{description}</p>
    <ul class="mt-10 space-y-8">
      {
        posts.map((post) => (
          <li class="border-b border-gray-200 pb-8 dark:border-slate-700">
            <h2 class="text-2xl font-semibold">
              <a class="hover:underline" href={getPermalink(`/zh-cn/${post.id}`)}>
                {post.data.title}
              </a>
            </h2>
            <p class="mt-2 text-muted">{post.data.excerpt}</p>
            <div class="mt-3 flex flex-wrap gap-3 text-sm">
              {post.data.category && (
                <a href={getPermalink(`/zh-cn/category/${cleanSlug(post.data.category)}`)} class="underline">
                  {post.data.category}
                </a>
              )}
              {post.data.tags?.map((tag) => (
                <a href={getPermalink(`/zh-cn/tag/${cleanSlug(tag)}`)} class="underline">
                  #{tag}
                </a>
              ))}
            </div>
          </li>
        ))
      }
    </ul>
    {
      (prevUrl || nextUrl) && (
        <nav aria-label="文章分页" class="mt-10 flex justify-between gap-4">
          {prevUrl ? (
            <a href={prevUrl} class="underline">
              ← 上一页
            </a>
          ) : (
            <span />
          )}
          <span>第 {currentPage} 页</span>
          {nextUrl ? (
            <a href={nextUrl} class="underline">
              下一页 →
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </section>
</Layout>
